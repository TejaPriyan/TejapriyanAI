DATABASE_URL="file:./dev.db"

# Signs the httpOnly session cookies — REQUIRED in production.
# Generate with:  openssl rand -hex 32
AUTH_SECRET=

# Public URL of this app (OpenRouter attribution headers). Optional.
# APP_URL="http://localhost:3000"

# --- Ollama: FREE, no API key, runs locally. Nothing to fill in. ---
# Only set this if Ollama runs somewhere other than the default.
# OLLAMA_HOST="http://127.0.0.1:11434"

# --- Optional free cloud fallbacks ---
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HF_TOKEN=
